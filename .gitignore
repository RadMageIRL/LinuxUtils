# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Editors / tooling
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Local scratch - keep experiments out of the repo
scratch/
tmp/
*.local
*.log

# Captured logs used as test fixtures are repo content, not scratch. Without
# this the *.log rule above silently drops them and the suite fails on a fresh
# clone with a missing-fixture error that points nowhere near the cause.
!*/tests/fixtures/*.log
