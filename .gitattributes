# Normalize everything to LF in the repo. Non-negotiable for shebang scripts:
# a CRLF line ending on line 1 makes Linux report "bad interpreter".
* text=auto eol=lf

*.py    text eol=lf diff=python
*.sh    text eol=lf
*.md    text eol=lf
LICENSE text eol=lf

# Never touch these
*.png   binary
*.jpg   binary
*.gz    binary
*.zip   binary
